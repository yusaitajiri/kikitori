# Normalize to LF in the repo, check out native on Windows
* text=auto

# Keep these LF even on Windows (tooling is picky)
*.sh        text eol=lf
*.rs        text eol=lf
*.toml      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.css       text eol=lf
*.html      text eol=lf

# Windows scripts need CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary - never diff or convert
*.wav       binary
*.mp3       binary
*.bin       binary
*.gguf      binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.ico       binary
*.icns      binary
*.pdf       binary
*.ttf       binary
*.woff2     binary

# Lockfiles: collapse diffs in review
pnpm-lock.yaml   -diff linguist-generated
Cargo.lock       -diff linguist-generated
