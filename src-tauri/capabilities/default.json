{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: Kikitori's own commands plus the core APIs the UI uses (events, native menu, window dragging). No plugin commands are exposed to the webview.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-get-app-info",
    "allow-get-settings",
    "allow-set-settings",
    "allow-list-audio-apps",
    "allow-list-mic-devices",
    "allow-watch-app-levels",
    "allow-start-recording",
    "allow-stop-recording",
    "allow-cancel-finishing",
    "allow-pause-recording",
    "allow-resume-recording",
    "allow-switch-to-system",
    "allow-take-screenshot",
    "allow-get-session",
    "allow-copy-transcript",
    "allow-export-markdown",
    "allow-export-pdf",
    "allow-export-typst",
    "allow-open-path",
    "allow-open-mic-privacy",
    "allow-open-logs",
    "allow-list-recoverable",
    "allow-recover-session",
    "allow-list-sessions",
    "allow-delete-session",
    "allow-delete-sessions",
    "allow-rename-session",
    "allow-update-segment",
    "allow-delete-segment",
    "allow-delete-screenshot",
    "allow-set-caption",
    "allow-models-list",
    "allow-model-download",
    "allow-model-cancel",
    "allow-model-select",
    "allow-model-delete",
    "allow-model-import",
    "allow-run-benchmark",
    "allow-retry-gpu",
    "allow-mic-test",
    "allow-complete-setup",
    "allow-set-window-layout",
    "allow-window-action",
    "allow-quit-app",
    "allow-install-update",
    "allow-pick-folder",
    "allow-pick-model-file"
  ]
}
